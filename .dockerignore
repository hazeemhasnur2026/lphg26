# Dibangun ulang di dalam image, jadi menyalinnya hanya memperlambat build dan
# berisiko membawa berkas yang dikompilasi untuk arsitektur berbeda.
**/node_modules
backend/vendor
backend/public/build

# Riwayat git tidak dibutuhkan saat berjalan, dan ukurannya 164 MB.
.git
.github

# Rahasia tidak pernah masuk image. Nilainya diberikan saat container jalan.
backend/.env
backend/.env.backup

# Keadaan lokal.
backend/database/*.sqlite
backend/storage/logs/*
backend/storage/framework/cache/*
