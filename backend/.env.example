APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_CONTACT_RECIPIENT="info@hasnurgroup.com"
MAIL_RECRUITMENT_RECIPIENT="recruitment@hasnurgroup.com"
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Analytics (CMS-10). Kosong berarti mati — sengaja, supaya kunjungan tim
# sendiri di mesin pengembang tidak bercampur ke angka produksi.
# Isi salah satu, bukan keduanya: GTM memuat GA dari dalam dirinya, dan dua
# pemuat sekaligus menghitung tiap kunjungan dua kali.
ANALYTICS_GA_ID=
ANALYTICS_GTM_ID=

# Pencatatan peristiwa oleh situs sendiri, dibaca di panel pada menu Analitik.
# Nyala secara bawaan dan tidak menunggu keputusan platform: tidak ada skrip
# pihak ketiga yang termuat dan tidak ada data yang meninggalkan server ini.
# Disetel false untuk mematikannya.
ANALYTICS_INTERNAL=true

# Masa simpan peristiwa analitik, dalam bulan. Tabelnya bertambah satu baris
# tiap klik. Diisi 0 berarti tidak ada pemangkasan.
ANALYTICS_RETENTION_MONTHS=12
