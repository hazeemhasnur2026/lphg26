# Template .env untuk server produksi.
#
# backend/.env.example sengaja tetap berisi nilai pengembangan, karena berkas itu
# juga dipakai CI dan mesin pengembang. SESSION_SECURE_COOKIE=true di sana akan
# membuat sesi tidak pernah terkirim lewat http, sehingga login admin gagal di
# `php artisan serve` dan seluruh test panel admin ikut merah.
#
# Salin berkas ini menjadi backend/.env di server, lalu isi yang kosong.
# deploy/after-deploy.sh menolak melanjutkan bila nilai di bawah tidak sesuai.

APP_NAME="Hasnur Group"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.hasnurgroup.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=error

# SQLite memadai untuk trafik situs ini. Berkasnya harus di luar document root.
DB_CONNECTION=sqlite
# Di dalam Docker nilainya /app/data/database.sqlite, dipasang sebagai volume.
# DB_DATABASE=/path/di/luar/public/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_RECIPIENT=info@hasnurgroup.com

# Analytics (CMS-10). Kosong berarti mati — sengaja, supaya kunjungan tim
# sendiri di mesin pengembang tidak bercampur ke angka produksi.
# Isi salah satu, bukan keduanya: GTM memuat GA dari dalam dirinya, dan dua
# pemuat sekaligus menghitung tiap kunjungan dua kali.
ANALYTICS_GA_ID=
ANALYTICS_GTM_ID=
